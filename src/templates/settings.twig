{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("brilliance\\algoliasync\\assetbundles\\algoliasync\\AlgoliaSyncAsset") %}

<h1>What Element Types to Sync with Algolia?</h1>

{% for supportedElementType in supportedElementsConfig %}
    <h1>{{ supportedElementType.label }}</h1>
    {% if supportedElementType.data | length > 0 %}
        <p>Which {{ supportedElementType.label }} to automatically sync with Algolia?</p>
        <table class="data fullwidth fixed-layout" dir="ltr">
            <tbody>
            <tr>
                <th>Include in Sync?</th>
                <th>Default Algolia Index Name</th>
                <th>Override Default Algolia Index Name</th>
            </tr>
            {% for data in supportedElementType.data %}
                <tr>
                    <th class="light">
                        {{ forms.lightswitchField({
                            label: data.label,
                            name: "algoliaElements["~supportedElementType.handle~"]["~data.value~"][sync]",
                            on: settings.algoliaElements[supportedElementType.handle][data.value]['sync'] ?? false,
                        }) }}
                    </th>
                    <td><pre>{{ data.default_index | default('no default available') }}</pre></td>
                    <td class="light">
                        {{ forms.autosuggestField({
                            name: "algoliaElements["~supportedElementType.handle~"]["~data.value~"][customIndex]",
                            value: settings.algoliaElements[supportedElementType.handle][data.value]['customIndex'] ?? '',
                            suggestEnvVars: true
                        }) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        {% set editionName = craft.app.getEditionName() | lower %}
        {% if supportedElementType.handle == 'userGroup' and editionName == 'solo' %}
            <p>Your Craft CMS edition is "Solo" and does not support User Groups</p>
        {% else %}
            <p>Your installation does not have any {{ supportedElementType.label }} that can be configured to Sync with Algolia</p>
        {% endif %}
    {% endif %}
{% endfor %}


<hr>
<h1>Multi-Site Options</h1>

{{ forms.lightswitchField({
    label: 'Append Site ID to Default Site Object IDs',
    instructions: 'When enabled, the default site will use object IDs in the format "123-1". When disabled, the default site will use "123" format for backward compatibility. Note: Changing this setting will create new records in Algolia. You may need to manually remove old records.',
    warning: 'Changing this setting after initial setup may result in duplicate records in Algolia until old records are manually removed.',
    id: 'appendSiteIdToDefaultSite',
    name: 'appendSiteIdToDefaultSite',
    on: settings.appendSiteIdToDefaultSite ?? false,
}) }}

<hr>
<h1>Bulk Load of Records</h1>
<a href="{{ cpUrl('utilities/algolia-sync-utility') }}" class="go">Visit the Utilities Page to Bulk Load Records</a>

<hr>
<h1>Cleanup Stale Records</h1>
<p class="light">
    Remove records from Algolia that have been deleted, disabled, or expired in Craft.
</p>
<a href="{{ cpUrl('utilities/algolia-sync-utility') }}" class="go">Visit the Utilities Page to Cleanup Stale Records</a>

<hr>
<h1>Queue Settings</h1>

{{ forms.textField({
    label: 'Queue Job Priority',
    instructions: 'Priority for Algolia sync queue jobs. Lower numbers = higher priority. Default Craft priority is 1024. Set this lower than other plugins (like Blitz at 100) to process Algolia syncs first.',
    id: 'queuePriority',
    name: 'queuePriority',
    value: settings.queuePriority ?? 50,
    type: 'number',
    min: 1,
    max: 9999,
    size: 5,
}) }}

<hr>
<h1>Algolia API Keys</h1>
{{ forms.autosuggestField({
    label: 'Algolia Application ID',
    id: 'algoliaApp',
    name: 'algoliaApp',
    value: settings['algoliaApp'],
    suggestEnvVars: true,
    suggestions: craft.cp.getEnvSuggestions(),
}) }}

{{ forms.autosuggestField({
    label: 'Algolia Search-Only API Key',
    id: 'algoliaSearch',
    name: 'algoliaSearch',
    value: settings['algoliaSearch'],
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: 'Algolia Admin API Key',
    id: 'algoliaAdmin',
    name: 'algoliaAdmin',
    value: settings['algoliaAdmin'],
    suggestEnvVars: true
}) }}




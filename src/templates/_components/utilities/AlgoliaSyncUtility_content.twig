{# @var craft \craft\web\twig\variables\CraftVariable #}
{% do view.registerAssetBundle('brilliance\\algoliasync\\assetbundles\\algoliasync\\AlgoliaSyncAsset') %}

{% set message = craft.app.session.getFlash('yourVariable') %}

<div class="pane">
    <h1 class="heading">Bulk Load Records into Algolia</h1>

    {% if message %}
        <div class="notification">
            {{ message }}
        </div>
    {% endif %}

    <p class="light">
        This will queue up every record from the selected types to be sent to Algolia. It will not create duplicates or remove existing records in Algolia that no longer exist in Craft.
    </p>
    <p>
        If you want a clean slate, <strong>clear the Algolia index manually first</strong>.
    </p>
    <p>
        <a href="{{ cpUrl('settings/plugins/algolia-sync') }}" class="go">Go to the Settings Page</a> to configure which elements are synced.
    </p>

    <form action="{{ actionUrl('algolia-sync/default/load-records') }}" method="post" id="algoliaSyncLoad">
        {{ csrfInput() }}
        {{ redirectInput(craft.app.request.url) }}

        {% for elementType in supportedElementsConfig %}
            <fieldset class="field">
                <legend class="heading">{{ elementType.label }}</legend>
                <div class="checkbox-group">
                    {% set elementTypeSync = false %}
                    {% for item in elementType.data %}
                        {% set config = settings['algoliaElements'][elementType.handle][item.value] ?? null %}
                        {% if config and config.sync == '1' %}
                            <div>
                                <label>
                                    <input type="checkbox" class="algoliaLoadCheckbox" name="loadRecords[]" value="{{ elementType.handle }}|{{ item.value }}">
                                    Send all <strong>{{ item.label }}</strong> to sync with Algolia
                                </label>
                            </div>
                            {% set elementTypeSync = true %}
                        {% endif %}
                    {% endfor %}
                    {% if not elementTypeSync %}
                        <div class="light">
                            No {{ elementType.label|lower }} configured to sync. <a href="{{ cpUrl('settings/plugins/algolia-sync') }}">Configure now</a>.
                        </div>
                    {% endif %}
                </div>
            </fieldset>
        {% endfor %}

        <div class="buttons">
            <button type="submit" class="btn submit">Bulk Load Records</button>
        </div>
    </form>
</div>

<hr>

<div class="pane">
    <h1 class="heading">Cleanup Stale Records in Algolia</h1>

    <p class="light">
        This will check all records in your configured Algolia indexes and remove any that are:
    </p>
    <ul class="light">
        <li>Deleted from Craft</li>
        <li>Disabled in Craft</li>
        <li>Expired (expiry date has passed)</li>
    </ul>
    <p>
        The cleanup process scans all records efficiently in batches and queues deletions for stale records.
    </p>

    <form action="{{ actionUrl('algolia-sync/default/cleanup-stale-records') }}" method="post" id="algoliaCleanupStale">
        {{ csrfInput() }}
        {{ redirectInput(craft.app.request.url) }}

        <div class="buttons">
            <button type="submit" class="btn submit">Cleanup Stale Records</button>
        </div>
    </form>

    <hr>

    <h2 class="heading">Automate with Cron</h2>
    <p class="light">
        For automatic cleanup of expired records, set up a cron job to run the cleanup command regularly:
    </p>
    <pre style="background: #f5f5f5; padding: 10px; border-radius: 3px; overflow-x: auto;"><code># Run daily at 2:00 AM
0 2 * * * cd /path/to/project && php craft algolia-sync/default/cleanup-stale-records

# Run every 6 hours
0 */6 * * * cd /path/to/project && php craft algolia-sync/default/cleanup-stale-records</code></pre>
    <p class="light">
        Replace <code>/path/to/project</code> with your actual project path.
    </p>
</div>
